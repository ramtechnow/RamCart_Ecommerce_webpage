{
  "expo": {
    "name": "RamCartMobile",
    "slug": "ramcart-mobile",
    "scheme": "ramcartmobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.ramcart.mobile"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser"
    ]
  }
}
